# fy26/.env is written for you by the setup notebook (course.write_env()) from your
# Terraform outputs. This file only documents the variables. Never commit .env.

STUDENT_ID=abc1234
# foundry = real models; offline = deterministic stand-ins, no Azure (used by tests)
LLM_MODE=foundry
FOUNDRY_PROJECT_ENDPOINT=https://aif-<name>.services.ai.azure.com/api/projects/proj-<student_id>
FOUNDRY_OPENAI_ENDPOINT=https://aif-<name>.openai.azure.com/openai/v1/
FOUNDRY_MODEL=gpt-5.4-mini
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
APP_URL=https://ca-<name>.<region>.azurecontainerapps.io

# Week 10 (optional): require this value in the X-API-Key header
# SERVICE_API_KEY=
